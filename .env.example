# ====================================================================
# Cyber Doppelgänger - Environment Configuration Template
# Copy to .env for local overrides. Do NOT commit real credentials or production secrets.
# ====================================================================

# Database Configuration (PostgreSQL Production)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cyber_doppelganger
DB_USERNAME=postgres_user
DB_PASSWORD=your_secure_password_here

# Spring Boot Backend Configuration
# Active profile: 'dev' (In-memory H2 in PostgreSQL mode) or 'postgres' (External PostgreSQL Cluster)
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Machine Learning Microservice Configuration
ML_SERVICE_URL=http://localhost:5001
ML_SERVICE_PORT=5001

# Security & Authentication (JWT Secrets)
# For production, generate a secure random 256-bit key
JWT_SECRET=GENERATE_SECURE_256BIT_SECRET_FOR_PRODUCTION_USE_ONLY
JWT_EXPIRATION_MS=86400000

# Desktop Behavioural Telemetry Agent
BACKEND_ENABLED=true
BACKEND_URL=http://localhost:8080
AGENT_DEVICE_ID=desktop-workstation-01
AGENT_REQUEST_TIMEOUT=3.0
AGENT_LOG_LEVEL=INFO
AGENT_WINDOW_SECONDS=60
KEYBOARD_PAUSE_THRESHOLD_SECONDS=1.0
IDLE_THRESHOLD_SECONDS=60.0
LOCAL_SNAPSHOT_STORAGE=true
SNAPSHOT_STORAGE_PATH=agent/data/feature_snapshots.jsonl

# Frontend UI Configuration
VITE_API_BASE_URL=http://localhost:8080
